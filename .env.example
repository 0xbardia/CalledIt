# CalledIt environment. Copy to .env. Never commit .env.
# This app is Vite, so browser values use VITE_.

# Leave NODE_ENV unset in this file. A development value here is loaded during
# `vite build` and the production server then crashes on jsxDEV.
# The host sets NODE_ENV=production. Local `npm run dev` is already development.
APP_URL=http://127.0.0.1:8080
PORT=8080

# Leave empty to use the built-in Postgres-compatible database.
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

GENLAYER_NETWORK=studionet
GENLAYER_CHAIN_ID=61999
GENLAYER_RPC_URL=https://studio.genlayer.com/api
# Empty until a reviewed contract is deployed. Do not invent an address.
GENLAYER_CONTRACT_ADDRESS=
# Comma-separated previous CalledIt contract addresses retained in public history.
GENLAYER_ARCHIVED_CONTRACT_ADDRESSES=

VITE_GENLAYER_NETWORK=studionet
VITE_GENLAYER_CHAIN_ID=61999
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api
VITE_GENLAYER_CONTRACT_ADDRESS=
VITE_PUBLIC_HOSTNAME=

# Optional. WalletConnect needs a real project id from cloud.walletconnect.com.
# Leave empty to use the injected browser wallet only.
VITE_WALLETCONNECT_PROJECT_ID=

LOG_LEVEL=info

# Dev-only labeled drafts. Must stay false in production.
ALLOW_SIMULATOR=true

PLAYWRIGHT_BASE_URL=http://127.0.0.1:8080

# Test harness only. Never read this from the server.
# E2E_PRIVATE_KEY=

# Hosted Studio maintenance only. Keep separate from the test wallet and never
# pass either key to the CalledIt production process.
# GENLAYER_DEPLOYER_PRIVATE_KEY=
